
<div class="row justify-content-center shadow-sm bg-light bg-gradient rounded login-container">
  <div class="col-sm-hidden col-md-6 col-lg-6 p-3 flex-1">
    <h2 class="h1 mb-3 p-3">
      Recognition for distributed teams felt impossible. <br><span class="text-recognize">Until now.</span>
    </h2>
    <%= image_tag "woman-laptop.png", alt: "Recognize", class: "img-fluid img-woman-laptop" %>
  </div>
  <div class="col-sm-12 col-md-6 col-lg-6 p-3 login-form align-content-center px-5 shadow-left">
    <h1 class="h4 mb-3">Login</h1>
    <%= form_with url: login_path, method: :post, class: 'vstack gap-3' do %>
      <div>
        <label class="form-label small">Email</label>
        <%= email_field_tag :email, params[:email], class: 'form-control form-control-sm' %>
      </div>
      <div>
        <label class="form-label small">Password</label>
        <%= password_field_tag :password, nil, class: 'form-control form-control-sm' %>
      </div>
      <div>
        <%= submit_tag 'Login', class: 'btn btn-primary btn-sm w-100' %>
      </div>
    <% end %>
    <p class="mt-3 small text-muted">Use seeded credentials (see README).</p>
  </div>
</div>